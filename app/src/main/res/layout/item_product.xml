<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Image -->
        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="90dp">

            <ImageView
                android:id="@+id/productImage"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:scaleType="centerCrop"
                android:background="@color/cream"/>

            <TextView
                android:id="@+id/productBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:background="@color/terra"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/productCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/terra"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/productName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/navy"
                android:textSize="15sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/productDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="2dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/productPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/navy"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/productUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#999999"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp"/>

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

                <!-- Out of stock label -->
                <TextView
                    android:id="@+id/oosLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Out of stock"
                    android:textColor="#C0392B"
                    android:textSize="11sp"
                    android:visibility="gone"/>

                <!-- ADD button -->
                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="80dp"
                    android:layout_height="34dp"
                    android:text="ADD"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    style="@style/Widget.MaterialComponents.Button"
                    android:backgroundTint="@color/terra"
                    android:textColor="@color/white"/>

                <!-- Qty row -->
                <LinearLayout
                    android:id="@+id/qtyRow"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:background="@drawable/qty_bg"
                    android:visibility="gone"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnDec"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="−"
                        android:textSize="18sp"
                        android:textColor="@color/terra"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:minWidth="0dp"
                        android:padding="0dp"/>

                    <TextView
                        android:id="@+id/tvQty"
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/navy"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <Button
                        android:id="@+id/btnInc"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="+"
                        android:textSize="18sp"
                        android:textColor="@color/terra"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:minWidth="0dp"
                        android:padding="0dp"/>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
