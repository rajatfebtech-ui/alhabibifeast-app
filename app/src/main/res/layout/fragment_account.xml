<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0E8">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:background="@color/navy" android:gravity="center_vertical" android:paddingStart="20dp">
            <TextView android:text="Account" android:textColor="#FFFFFF" android:textSize="18sp" android:fontFamily="serif"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_margin="12dp" app:cardCornerRadius="16dp" app:cardElevation="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp">

                <TextView android:text="Delivery Details" android:textColor="@color/navy"
                    android:textSize="16sp" android:fontFamily="serif" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Full Name *" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="12dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/acName"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textPersonName"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Phone Number *" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="12dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/acPhone"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="phone"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Address *" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="12dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/acAddress"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textMultiLine" android:lines="2"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="City" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="12dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/acCity"
                        android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="PIN Code (247667 - Roorkee)" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/acPin"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number" android:maxLength="6"/>
                </com.google.android.material.textfield.TextInputLayout>

                <Button android:id="@+id/btnSaveAccount"
                    android:layout_width="match_parent" android:layout_height="50dp"
                    android:text="Save Details"
                    style="@style/Widget.MaterialComponents.Button"
                    android:backgroundTint="@color/navy" android:textColor="@color/white"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Quick links -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_margin="12dp" android:layout_marginTop="0dp"
            app:cardCornerRadius="16dp" app:cardElevation="2dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <Button android:id="@+id/btnOrders"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="📋  My Orders"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="@color/navy" android:layout_marginBottom="10dp"/>

                <Button android:id="@+id/btnWhatsAppSupport"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="💬  WhatsApp Support"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#25D366" android:layout_marginBottom="10dp"/>

                <Button android:id="@+id/btnFranchise"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="🤝  Franchise Enquiry"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="@color/terra"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button android:id="@+id/btnRiderLogin"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="🛵  Rider Login"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@color/navy" android:layout_marginBottom="10dp"/>

        <TextView android:text="Delivering only in Roorkee (PIN 247667)\n© Al Habibi Feast"
            android:textColor="#AAAAAA" android:textSize="12sp" android:gravity="center"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="20dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
