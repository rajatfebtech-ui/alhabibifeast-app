<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F0E8">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:background="@color/navy" android:gravity="center_vertical" android:paddingStart="20dp">
        <TextView android:text="Your Cart" android:textColor="#FFFFFF" android:textSize="18sp" android:fontFamily="serif"/>
    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout android:id="@+id/cartEmpty" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical"
        android:gravity="center" android:visibility="gone">
        <TextView android:text="🛒" android:textSize="56sp" android:gravity="center"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Your cart is empty" android:textSize="18sp" android:textColor="@color/navy"
            android:fontFamily="serif" android:gravity="center" android:layout_marginTop="12dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Add some fresh cuts to get started" android:textSize="14sp"
            android:textColor="#888888" android:gravity="center" android:layout_marginTop="4dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Cart items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"/>

    <!-- Checkout card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/checkoutCard"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp" android:background="@color/white">

            <!-- Totals -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:text="Subtotal" android:textColor="#666666" android:textSize="14sp"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                <TextView android:id="@+id/tvSubtotal" android:textColor="@color/navy" android:textSize="14sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:text="Delivery" android:textColor="#666666" android:textSize="14sp"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                <TextView android:id="@+id/tvShipping" android:textColor="@color/ok" android:textSize="14sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#EEEEEE" android:layout_marginTop="8dp" android:layout_marginBottom="8dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:text="Total" android:textColor="@color/navy" android:textSize="16sp"
                    android:textStyle="bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                <TextView android:id="@+id/tvTotal" android:textColor="@color/navy" android:textSize="18sp"
                    android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Action buttons -->
            <Button android:id="@+id/btnCod"
                android:layout_width="match_parent" android:layout_height="50dp"
                android:text="Place Order (Cash on Delivery)"
                android:layout_marginTop="14dp"
                style="@style/Widget.MaterialComponents.Button"
                android:backgroundTint="@color/navy" android:textColor="@color/white"/>

            <Button android:id="@+id/btnOnline"
                android:layout_width="match_parent" android:layout_height="50dp"
                android:text="Pay Online (UPI / Cards)"
                android:layout_marginTop="8dp"
                style="@style/Widget.MaterialComponents.Button"
                android:backgroundTint="@color/terra" android:textColor="@color/white"/>

            <Button android:id="@+id/btnWhatsapp"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="📲 Order via WhatsApp"
                android:layout_marginTop="6dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#25D366"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
