<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AlHabibiFeast" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/terra</item>
        <item name="colorPrimaryVariant">@color/navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="chipStyle">@style/ChipStyle</item>
    </style>

    <style name="Theme.AlHabibiFeast.Splash" parent="Theme.AlHabibiFeast">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/navy</item>
    </style>

    <style name="ChipStyle" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/white</item>
        <item name="checkedIconEnabled">false</item>
        <item name="chipStrokeColor">@color/terra</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/navy</item>
    </style>
</resources>
